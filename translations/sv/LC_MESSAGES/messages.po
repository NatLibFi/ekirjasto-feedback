#: app.py:51
msgid "Thank you for your feedback!"
msgstr "Tack för din respons!"

#: app.py:56 app.py:105
msgid "There was a problem sending your message."
msgstr "Det uppstod ett problem med att skicka ditt meddelande."

#: app.py:66
#, fuzzy
msgid ""
"There was a problem sending your message. Please refresh the page and try"
" again."
msgstr "Det uppstod ett problem med att skicka ditt meddelande. Vänligen uppdatera sidan och försök igen."

#: app.py:88
msgid ""
"You have already sent feedback within the last minute. Please wait before"
" sending again."
msgstr ""
"Du har redan skickat respons inom de senaste minuterna. Vänta en stund "
"innan du skickar igen."

