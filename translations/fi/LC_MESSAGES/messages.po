#: forms/feedback.py:49
msgid "My home municipality that receives this feedback"
msgstr "Kotikuntani, jolle palaute osoitetaan"

#: forms/feedback.py:50
msgid "Select a municipality"
msgstr "Valitse kotikunta"

#: forms/feedback.py:57
msgid ""
"Your home municipality is needed to direct your feedback to the right "
"library."
msgstr "Kotikunnan valitseminen ohjaa palautteen oikeaan kirjastoon."

#: forms/feedback.py:61
msgid "Email address, if you want an answer to your feedback (Optional)"
msgstr "Sähköpostiosoite, johon haluat vastauksen palautteellesi (Valinnainen)"

#: forms/feedback.py:65
msgid "Send"
msgstr "Lähetä"


msgid "E-library feedback"
msgstr "E-kirjaston palautelomake"

msgid "Language"
msgstr "Kieli"

msgid "Please check the following fields."
msgstr "Tarkista seuraavat kentät."

msgid "Sending your feedback…"
msgstr "Palautetta lähetetään…"

msgid "Please wait one minute before sending feedback again."
msgstr "Odota minuutti ennen seuraavan palautteen lähettämistä."

msgid "This form has already been submitted. Open a new form to send more feedback."
msgstr "Tämä lomake on jo lähetetty. Avaa uusi lomake, jos haluat lähettää lisää palautetta."

msgid "Return to the form"
msgstr "Palaa lomakkeelle"

msgid "Search municipality"
msgstr "Hae kotikuntaa"

msgid "Filter the list, then select your municipality below."
msgstr "Rajaa listaa haulla ja valitse kotikuntasi alta."

msgid "Describe your feedback in as much detail as possible. For technical problems, tell us what you were doing, what happened, and what you expected to happen."
msgstr "Kuvaile palautteesi mahdollisimman tarkasti. Jos ilmoitat teknisestä ongelmasta, kerro mitä olit tekemässä, mitä tapahtui ja mitä odotit tapahtuvan."

msgid "Your home municipality's library will be the first to respond. If needed, they will forward your message to the right recipient."
msgstr "Kotikuntasi kirjasto vastaa ensisijaisesti viestiisi. Tarvittaessa he välittävät viestisi oikealle vastaanottajalle."

msgid "Before sending feedback, check whether the FAQ or user guide has a solution to your problem. Find them here:"
msgstr "Tarkistathan ennen palautteen lähettämistä, löytyykö ongelmaasi ratkaisu usein kysytyistä kysymyksistä tai käyttöohjeesta. Löydät ne täältä:"

msgid "E-library frequently asked questions"
msgstr "E-kirjaston usein kysytyt kysymykset"

msgid "E-library user guide"
msgstr "E-kirjaston käyttöohjeet"
